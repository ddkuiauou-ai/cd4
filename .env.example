# Copy to .env. Use a dedicated PostgreSQL database.
# The application and Drizzle connection commands prefer DATABASE_URL.
DATABASE_URL="postgresql://cd4_user:change-me@localhost:5432/cd4"

# Alternatively, remove DATABASE_URL and set these individual fields.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=cd4_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=cd4

# For a server requiring TLS, specify sslmode in DATABASE_URL.
# Example: postgresql://cd4_user:change-me@db.example.com:5432/cd4?sslmode=require
